# Mini SOC backend configuration.
# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored - NEVER commit real secrets.

# ---------------------------------------------------------------- core
# Signing key for session tokens. REQUIRED, at least 32 characters.
# Generate one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production   (production disables /docs and forces secure cookies)
APP_ENV=development

# SQLite database file (relative paths are relative to the backend folder)
DATABASE_URL=sqlite:///./data/soc.db

# How long a login lasts, in minutes
ACCESS_TOKEN_MINUTES=30

# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

# Browser origins allowed to send state-changing requests (JSON list)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# ---------------------------------------------------------------- tools
# Leave as the plain name if the tool is on PATH; common install folders are also checked.
NMAP_PATH=nmap
TSHARK_PATH=tshark

# ---------------------------------------------------------------- Wazuh (optional, see docs/LAB_SETUP.md)
# Leave WAZUH_API_URL empty to disable the integration.
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
# Prefer pointing WAZUH_CA_CERT at the Wazuh root CA (root-ca.pem) over disabling verification.
WAZUH_CA_CERT=
WAZUH_VERIFY_TLS=true
# Only import alerts at or above this Wazuh rule level (0-15)
WAZUH_MIN_RULE_LEVEL=7

# ---------------------------------------------------------------- Threat intelligence (optional)
# Free API keys: abuseipdb.com, virustotal.com, otx.alienvault.com. Empty = provider disabled.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
THREAT_INTEL_CACHE_HOURS=24
